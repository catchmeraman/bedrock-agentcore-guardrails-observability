<mxfile host="app.diagrams.net">
  <diagram name="Architecture Flow" id="arch-flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Amazon Bedrock AgentCore — Identity (Inbound/Outbound Auth) + Guardrails + Gateway Cedar Policy + Observability" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="16" width="1460" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="User / Client App" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="idbox" value="AgentCore Identity — INBOUND AUTH (WHO can invoke the agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#DD344C;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="120" width="360" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="cognito" value="Cognito / OIDC IdP&#xa;issues JWT" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="235" y="170" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="jwtverify" value="Bearer token (JWT) verify&#xa;discoveryUrl, allowedClients,&#xa;allowedAudience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="workloadid" value="Workload Identity&#xa;agent gets its own identity&#xa;+ workload access token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="210" y="290" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inauthdeny" value="401 / 403&#xa;caller rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="390" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="runtime" value="AgentCore Runtime (Agent / Harness loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ef;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="600" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="acicon" value="Bedrock&#xa;AgentCore" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1">
          <mxGeometry x="1110" y="135" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="gin" value="1. INBOUND Guardrail&#xa;ApplyGuardrail (INPUT)&#xa;prompt attack, denied topics,&#xa;PII, words, content filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="650" y="180" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="inblock" value="BLOCKED&#xa;safe message + trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="190" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="2. Foundation Model (Bedrock)&#xa;Claude / Nova / Llama" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelPosition=right;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="310" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="reason" value="3. Agent reasoning&#xa;decides to call a tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gout" value="5. OUTBOUND Guardrail&#xa;ApplyGuardrail (OUTPUT)&#xa;content, PII anonymize,&#xa;contextual grounding, words" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="650" y="760" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="outblock" value="BLOCKED / ANONYMIZED&#xa;mask + trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="770" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="deliver" value="6. Deliver safe response to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="650" y="900" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gwbox" value="AgentCore Gateway (managed MCP endpoint)  +  OUTBOUND AUTH (WHAT the agent may do)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#D9A741;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="300" width="400" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="gw_inauth" value="Gateway inbound auth&#xa;verify agent workload token (JWT/IAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="1290" y="345" width="340" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cedar" value="Policy Engine — CEDAR authorization&#xa;permit / forbid (principal, action, resource)&#xa;mode: LOG_ONLY or ENFORCE&#xa;e.g. weather tool only 9am-5pm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="425" width="340" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="denied" value="DENY&#xa;tool call rejected&#xa;decision logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="545" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="outauth" value="Outbound credentials&#xa;IAM role / OAuth / API key&#xa;(from Secrets Manager)" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;labelPosition=right;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="550" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lambda" value="Lambda tool" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1300" y="655" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="API Gateway&#xa;REST target" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="1420" y="655" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="mcp" value="MCP server&#xa;target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1540" y="655" width="90" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="toolsband" value="Backend Tools" style="text;html=1;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="725" width="340" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="obs" value="Observability Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#759C3E;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="1050" width="1060" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cw" value="CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1">
          <mxGeometry x="630" y="1085" width="50" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="invlog" value="Model Invocation Logging&#xa;guardrail trace -&gt; Logs / S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="1085" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="insights" value="Logs Insights&#xa;what was blocked, by filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="940" y="1085" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="metrics" value="Metrics + Alarms&#xa;block rate, attack spikes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1170" y="1085" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cedarlog" value="Cedar decision logs&#xa;allow / deny per tool call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1085" width="230" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_user_cog" value="1. sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="user" target="cognito">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cog_jwt" value="JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="cognito" target="jwtverify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jwt_deny" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="jwtverify" target="inauthdeny">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jwt_wl" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="jwtverify" target="workloadid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_wl_gin" value="invoke agent&#xa;(authenticated)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="workloadid" target="gin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gin_block" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="gin" target="inblock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gin_model" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="gin" target="model">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_model_reason" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="model" target="reason">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_reason_gw" value="4. tool call (MCP)&#xa;with workload token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="reason" target="gw_inauth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gwin_cedar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="gw_inauth" target="cedar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cedar_deny" value="forbid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="cedar" target="denied">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cedar_outauth" value="permit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="cedar" target="outauth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_outauth_lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="outauth" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_outauth_api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="outauth" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_outauth_mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="outauth" target="mcp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_tools_gout" value="tool result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="gwbox" target="gout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gout_block" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="gout" target="outblock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_gout_deliver" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="gout" target="deliver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_deliver_user" value="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="deliver" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_obs1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#759C3E;endArrow=none;" edge="1" parent="1" source="gin" target="invlog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_obs2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#759C3E;endArrow=none;" edge="1" parent="1" source="gout" target="metrics">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_obs3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#759C3E;endArrow=none;" edge="1" parent="1" source="cedar" target="cedarlog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Legend:   red border = identity / auth checkpoint     pink = safety guardrail     orange dashed = blocked/denied path     green dashed = telemetry to CloudWatch" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="600" y="1000" width="1060" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
