<mxfile host="app.diagrams.net">
  <diagram name="Memory Architecture" id="mem-arch">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Amazon Bedrock AgentCore Memory — Parallel Sessions, Isolation, Short-term vs Long-term, Preferences &amp; Storage" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="16" width="1480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="userA" value="User A&#xa;actorId = user-A" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="userB" value="User B&#xa;actorId = user-B" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="userC" value="User A again&#xa;(later, new session)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#879196;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="rt" value="AgentCore Runtime (agent) — one logical agent serving all users concurrently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ef;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="330" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="acicon" value="Bedrock&#xa;AgentCore" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=8;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1">
          <mxGeometry x="450" y="132" width="44" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="sessA" value="Session s-A1&#xa;(User A conversation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="200" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sessB" value="Session s-B1&#xa;(User B conversation, in parallel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="360" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sessC" value="Session s-A2&#xa;(User A, days later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="510" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="scopenote" value="Every call carries (memoryId, actorId, sessionId).&#xa;actorId = the user  |  sessionId = one conversation." style="text;html=1;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="215" y="270" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mem" value="AgentCore Memory resource (fully managed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#D9A741;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="620" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="stm" value="SHORT-TERM MEMORY (events)  —  raw turn-by-turn, per session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ef;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="560" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="ev_a" value="events for actor=user-A, session=s-A1&#xa;(msg, msg, tool, msg ...)  TTL = eventExpiryDuration (3-365d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;" vertex="1" parent="1">
          <mxGeometry x="655" y="165" width="510" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ev_b" value="events for actor=user-B, session=s-B1  (fully ISOLATED from user-A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;" vertex="1" parent="1">
          <mxGeometry x="655" y="215" width="510" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="ev_c" value="events for actor=user-A, session=s-A2  (new session = fresh short-term context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;" vertex="1" parent="1">
          <mxGeometry x="655" y="260" width="510" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="extract" value="Async extraction (managed)&#xa;strategies process events:&#xa;SEMANTIC / SUMMARIZATION /&#xa;USER_PREFERENCE / EPISODIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="340" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ltm" value="LONG-TERM MEMORY (records)  —  extracted insights, persist across sessions, organized by NAMESPACE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="480" width="560" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="ns_a_facts" value="users/user-A/facts&#xa;(semantic facts about User A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="655" y="520" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ns_a_pref" value="users/user-A/preferences&#xa;(USER_PREFERENCE records)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="520" width="245" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ns_a_epi" value="users/user-A/episodes/{sessionId}&#xa;(episodic per-session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="655" y="590" width="250" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ns_b_facts" value="users/user-B/facts&#xa;(User B — SEPARATE namespace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="590" width="245" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ns_shared" value="org/shared/policies  (OPTIONAL shared namespace — no {actorId} = intentionally shared across users)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="655" y="660" width="510" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="isonote" value="Isolation rule: a namespace template with {actorId} scopes records per user.&#xa;retrieve_memory_records(namespace=&quot;users/user-A/...&quot;) can only return User A's records.&#xa;Omit {actorId} ONLY when you deliberately want a shared namespace." style="text;html=1;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="655" y="710" width="510" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="retrieve" value="retrieve_memory_records&#xa;(semantic search, top-K,&#xa;scoped by namespace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="storebox" value="Storage &amp; Scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="90" width="380" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="managed" value="Option 1 — MANAGED (recommended)&#xa;AgentCore Memory owns storage &amp; scale.&#xa;You do NOT create DynamoDB tables.&#xa;Retention = eventExpiryDuration (short-term);&#xa;long-term records persist until deleted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ef;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="130" width="340" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="selfmanaged" value="Option 2 — SELF-MANAGED (only if you must own the store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=#ED7100;verticalAlign=top;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="300" width="340" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="ddb" value="DynamoDB — single-table design" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1340" y="345" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ddbkeys" value="ONE table, not many:&#xa;PK = USER#&lt;actorId&gt;&#xa;SK = SESSION#&lt;sessionId&gt;#TS#&lt;ts&gt;  (short-term events)&#xa;SK = MEM#&lt;namespace&gt;#&lt;recordId&gt;  (long-term records)&#xa;GSI1: PK=namespace, SK=score/updatedAt&#xa;TTL attribute on short-term items = auto-expire&#xa;On-demand capacity = scales with parallel users" style="text;html=1;align=left;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1320" y="405" width="320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="S3 — cold archive&#xa;(long retention / compliance)" style="sketch=0;points=[[0,0,0],[0.5,0,0],[1,0,0],[0,1,0],[0.5,1,0],[1,1,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" vertex="1" parent="1">
          <mxGeometry x="1340" y="560" width="55" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="vector" value="Vector store for semantic recall&#xa;(e.g. OpenSearch / pgvector) —&#xa;embeddings + kNN for retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="1320" y="640" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="selfnote" value="Self-managed = you run extraction (SNS+S3), embeddings,&#xa;TTL, backups, and scaling yourself. Prefer Option 1 unless&#xa;you have a hard data-ownership/residency requirement." style="text;html=1;align=left;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1320" y="705" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e_ua_sa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="userA" target="sessA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ub_sb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="userB" target="sessB"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_uc_sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="userC" target="sessC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sa_ev" value="create_event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="sessA" target="ev_a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sb_ev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="sessB" target="ev_b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sc_ev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="sessC" target="ev_c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_stm_ext" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="stm" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ext_ltm" value="write records&#xa;to namespaces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="extract" target="ltm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ltm_ret" value="scoped semantic search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ns_a_facts" target="retrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ret_rt" value="inject relevant memory&#xa;into next prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;" edge="1" parent="1" source="retrieve" target="sessC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_mem_managed" value="default" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#01A88D;" edge="1" parent="1" source="mem" target="managed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_mem_self" value="alternative" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#ED7100;" edge="1" parent="1" source="mem" target="selfmanaged"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend:   teal = short-term (events)   purple = long-term (records / namespaces)   pink = managed extraction   yellow = shared namespace (opt-in)   orange = self-managed storage" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="200" y="820" width="1470" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
